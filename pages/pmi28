import re
import unicodedata


def normalizar_nome_socio(nome):
    """Normaliza o nome para comparação, preservando o original para exibição."""
    if not nome:
        return ""

    nome = nome.strip().upper()
    nome = unicodedata.normalize("NFKD", nome)
    nome = "".join(
        caractere
        for caractere in nome
        if not unicodedata.combining(caractere)
    )
    nome = re.sub(r"\s+", " ", nome)
    nome = re.sub(r"[^\w\s]", "", nome)

    return nome.strip()


def extrair_socios_cadastro(texto):
    """
    Extrai nomes do bloco Sócios / Responsáveis do Cadastro Municipal.
    Aceita formatos em linhas ou tabelas com separadores.
    """
    if not texto:
        return []

    inicio = re.search(
        r"S[oó]cios?\s*/?\s*Respons[aá]veis",
        texto,
        flags=re.IGNORECASE
    )

    if not inicio:
        return []

    restante = texto[inicio.end():]

    fim = re.search(
        r"Atividade\s+Econ[oô]mica\s+CNAE|"
        r"Identifica[cç][aã]o\s+do\s+Contribuinte",
        restante,
        flags=re.IGNORECASE
    )

    bloco = restante[:fim.start()] if fim else restante[:3000]

    nomes = []

    for linha in bloco.splitlines():
        linha = linha.strip()

        if not linha:
            continue

        # Se houver cabeçalhos de tabela, não os trata como nomes.
        if re.search(
            r"^(CPF|CNPJ|NOME|S[ÓO]CIO|RESPONS[ÁA]VEL|"
            r"DOCUMENTO|QUALIFICA[ÇC][ÃA]O)\s*$",
            linha,
            flags=re.IGNORECASE
        ):
            continue

        # Divide linhas de tabelas que usam pipes.
        partes = [p.strip() for p in linha.split("|")]

        for parte in partes:
            parte = re.sub(r"\s+", " ", parte).strip(" -\t")

            # Ignora campos que não parecem nomes.
            if not parte or re.fullmatch(r"[\d./-]+", parte):
                continue

            if re.search(
                r"^(CPF|CNPJ|NOME|S[ÓO]CIO|RESPONS[ÁA]VEL|"
                r"DOCUMENTO|QUALIFICA[ÇC][ÃA]O|PESSOA F[ÍI]SICA)$",
                parte,
                flags=re.IGNORECASE
            ):
                continue

            if re.search(r"\d{3}\.\d{3}\.\d{3}-\d{2}", parte):
                parte = re.sub(
                    r"\d{3}\.\d{3}\.\d{3}-\d{2}", "", parte
                ).strip(" -")

            # Evita registrar trechos longos que não sejam nomes.
            if (
                len(parte) <= 100
                and re.search(r"[A-Za-zÀ-ÿ]", parte)
                and len(normalizar_nome_socio(parte).split()) >= 2
            ):
                if normalizar_nome_socio(parte) not in {
                    normalizar_nome_socio(n) for n in nomes
                }:
                    nomes.append(parte)

    return nomes


def comparar_socios(socios_cadastro, socios_legalizacao):
    """Compara os nomes sem depender da ordem em que aparecem."""
    cadastro_normalizado = {
        normalizar_nome_socio(nome): nome
        for nome in socios_cadastro
        if normalizar_nome_socio(nome)
    }

    legalizacao_normalizado = {
        normalizar_nome_socio(nome): nome
        for nome in socios_legalizacao
        if normalizar_nome_socio(nome)
    }

    em_comum = sorted(
        set(cadastro_normalizado) & set(legalizacao_normalizado)
    )
    somente_cadastro = sorted(
        set(cadastro_normalizado) - set(legalizacao_normalizado)
    )
    somente_legalizacao = sorted(
        set(legalizacao_normalizado) - set(cadastro_normalizado)
    )

    return {
        "em_comum": [
            cadastro_normalizado[nome] for nome in em_comum
        ],
        "somente_cadastro": [
            cadastro_normalizado[nome] for nome in somente_cadastro
        ],
        "somente_legalizacao": [
            legalizacao_normalizado[nome]
            for nome in somente_legalizacao
        ],
    }
