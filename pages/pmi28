st.subheader("👥 Comparação de sócios e responsáveis")

resultado = comparar_socios_documentos(
    texto_cadastro,
    texto_legalizacao
)

if not resultado["cadastro"] or not resultado["legalizacao"]:
    st.warning(
        "Não foi possível comparar os sócios. "
        "Verifique se os dois documentos foram extraídos corretamente "
        "e se contêm suas respectivas seções societárias."
    )
else:
    st.markdown("#### Resumo")

    col1, col2, col3 = st.columns(3)

    col1.metric(
        "Pessoas correspondentes",
        len(resultado["correspondentes"])
    )
    col2.metric(
        "Divergências de nome",
        len(resultado["divergencias_nome"])
    )
    col3.metric(
        "Pessoas não localizadas no outro documento",
        len(resultado["somente_cadastro"])
        + len(resultado["somente_legalizacao"])
    )

    if resultado["correspondentes"]:
        st.markdown("#### 🟢 Sócios correspondentes")

        for item in resultado["correspondentes"]:
            st.success(
                f'{item["nome_cadastro"]} — CPF: {item["cpf"]}'
            )

    if resultado["divergencias_nome"]:
        st.markdown("#### 🔴 Mesmo CPF, nomes diferentes")

        for item in resultado["divergencias_nome"]:
            st.error(
                f'CPF: {item["cpf"]}\n\n'
                f'Cadastro Municipal: {item["nome_cadastro"]}\n\n'
                f'Legalização: {item["nome_legalizacao"]}'
            )

    if resultado["somente_cadastro"]:
        st.markdown("#### 🟡 Encontrados somente no Cadastro Municipal")

        for item in resultado["somente_cadastro"]:
            st.warning(
                f'{item["nome"]} — CPF: {item["cpf"]}'
            )

    if resultado["somente_legalizacao"]:
        st.markdown("#### 🟡 Encontrados somente na Legalização")

        for item in resultado["somente_legalizacao"]:
            st.warning(
                f'{item["nome"]} — CPF: {item["cpf"]}'
            )

    if resultado["cadastro_sem_cpf"] or resultado["legalizacao_sem_cpf"]:
        st.info(
            "Existem registros sem CPF identificável. "
            "Eles precisam de conferência manual."
        )
